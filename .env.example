# Copy this file to a deployment-specific environment file and replace every value.
POSTGRES_DB=pfe_5g
POSTGRES_USER=pfe_5g
POSTGRES_PASSWORD=replace-with-a-long-unique-password
DATABASE_URL=postgresql://pfe_5g:replace-with-a-url-encoded-password@postgres:5432/pfe_5g?serverVersion=16&charset=utf8
APP_SECRET=replace-with-a-random-symfony-secret
CRON_TOKEN=replace-with-a-long-random-token
