{# templates/dashboard/superuser/plan_data.html.twig #}
{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
.plan-data-page { padding: 20px; }
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
.page-title { font-size: 28px; font-weight: 700; color: #0f172a; margin: 0; }
.stats-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; margin-bottom: 24px; }
.stat-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; }
.stat-number { font-size: 28px; font-weight: 800; }
.stat-label { font-size: 13px; color: #64748b; text-transform: uppercase; font-weight: 600; }
.stat-critical .stat-number { color: #ef4444; }
.stat-warning .stat-number { color: #f59e0b; }
.stat-secure .stat-number { color: #22c55e; }
.stat-total .stat-number { color: #3b82f6; }
.stat-s1 .stat-number { color: #7f1d1d; }
.filters-bar { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; background: #f8fafc; padding: 16px; border-radius: 12px; border: 1px solid #e2e8f0; align-items: end; }
.filter-group { display: flex; flex-direction: column; gap: 4px; }
.filter-group label { font-size: 12px; font-weight: 600; color: #64748b; }
.filter-group input, .filter-group select { padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; min-width: 160px; }
.filter-actions { display: flex; gap: 8px; align-items: center; margin-left: auto; }
.table-wrap { overflow-x: auto; background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; }
.table-wrap table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 2100px; }
.table-wrap th { background: #f1f5f9; text-align: left; padding: 10px 12px; font-weight: 700; color: #1e293b; border-bottom: 2px solid #e2e8f0; white-space: nowrap; }
.table-wrap td { padding: 8px 12px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; white-space: nowrap; }
.badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; white-space: nowrap; }
.badge-red { background: #fee2e2; color: #991b1b; }
.badge-yellow { background: #fef9c3; color: #854d0e; }
.badge-orange { background: #ffedd5; color: #c2410c; }
.badge-green { background: #ccfbf1; color: #065f46; }
.badge-gray { background: #f1f5f9; color: #475569; }
.badge-s1 { background: #450a0a; color: #fecaca; font-weight: 700; }
.btn-sm { padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; border: none; cursor: pointer; }
.btn-outline { background: transparent; border: 1px solid #cbd5e1; color: #334155; }
.btn-primary-sm { background: #3b82f6; color: #fff; }
.btn-warning-sm { background: #f59e0b; color: #fff; }
.btn-export { background: #10b981; color: #fff; }
.pagination { display: flex; gap: 6px; justify-content: center; margin-top: 20px; flex-wrap: wrap; }
.pagination a, .pagination span { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 36px; padding: 0 10px; border-radius: 8px; border: 1px solid #e2e8f0; background: #fff; color: #1e293b; text-decoration: none; font-size: 14px; }
.pagination .active { background: #3b82f6; color: #fff; border-color: #3b82f6; }
.action-buttons { display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; flex-wrap: wrap; }
.action-buttons .btn { padding: 10px 24px; border-radius: 10px; font-weight: 600; border: none; cursor: pointer; }
.btn-success { background: #22c55e; color: #fff; }
.btn-purple { background: #8b5cf6; color: #fff; }
.modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000; }
.modal-overlay.active { display: flex; }
.modal-box { background: #fff; border-radius: 16px; padding: 32px; max-width: 480px; width: 90%; text-align: center; }
.modal-buttons { display: flex; gap: 12px; justify-content: center; }
.top10-badge { background: #fef3c7; color: #92400e; padding: 6px 14px; border-radius: 999px; font-weight: 600; font-size: 14px; display: inline-block; margin-bottom: 16px; }
@media (max-width: 1024px) { .stats-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 768px) { .stats-grid { grid-template-columns: 1fr 1fr; } .filters-bar { flex-direction: column; align-items: stretch; } .filter-group { min-width: auto; } }
</style>

<div class="plan-data-page">
    <div class="page-header">
        <h2 class="page-title">Plan Data</h2>
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            {% if imported %}
                <span class="badge badge-green" style="font-size:14px;">✅ Import effectué avec succès</span>
            {% endif %}
            <a href="{{ path('superuser_export_plan_data', { service: currentService, classification: currentClassification, search: currentSearch }) }}" class="btn btn-export btn-sm" style="padding: 8px 16px; text-decoration: none; border-radius: 8px;">📥 Export Plan Data</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card stat-total"><div class="stat-number">{{ totalSites }}</div><div class="stat-label">Total sites</div></div>
        <div class="stat-card stat-critical"><div class="stat-number">{{ criticalSites }}</div><div class="stat-label">Critiques</div></div>
        <div class="stat-card stat-warning"><div class="stat-number">{{ warningSites }}</div><div class="stat-label">Sous observation</div></div>
        <div class="stat-card stat-secure"><div class="stat-number">{{ secureSites }}</div><div class="stat-label">OK / Sécurisés</div></div>
        <div class="stat-card" style="border-left: 4px solid #8b5cf6;"><div class="stat-number">{{ sansTypeSites }}</div><div class="stat-label">Sans type</div></div>
        <div class="stat-card stat-s1" style="border-left: 4px solid #7f1d1d;"><div class="stat-number">{{ s1DownSites|default(0) }}</div><div class="stat-label">Coupures S1</div></div>
    </div>

    <div class="filters-bar">
        <div class="filter-group"><label for="search">Recherche</label><input type="text" id="search" name="search" value="{{ currentSearch }}" placeholder="Nom du site..."></div>
        <div class="filter-group"><label for="service">Service</label>
            <select id="service" name="service"><option value="">Tous</option>{% for svc in services %}<option value="{{ svc }}" {% if svc == currentService %}selected{% endif %}>{{ svc }}</option>{% endfor %}</select>
        </div>
        <div class="filter-group"><label for="classification">Classification</label>
            <select id="classification" name="classification"><option value="">Toutes</option>{% for class in classifications %}<option value="{{ class }}" {% if class == currentClassification %}selected{% endif %}>{{ class }}</option>{% endfor %}</select>
        </div>
        <div class="filter-group"><label for="worstFilter">Filtre</label>
            <select id="worstFilter">
                <option value="all" {% if not isTop10 and not isNeedsUpdate %}selected{% endif %}>Tous</option>
                <option value="top10" {% if isTop10 %}selected{% endif %}>🔴 Top 10 worst (occurrences)</option>
                <option value="needsUpdate" {% if isNeedsUpdate %}selected{% endif %}>🛠 Sites à compléter (capacité / type trans)</option>
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary-sm" id="applyFilters">Appliquer</button>
            <button class="btn btn-outline" id="resetFilters">Réinitialiser</button>
        </div>
    </div>

    {% if isTop10 %}<div class="top10-badge">🔴 Affichage des 10 sites avec le plus grand nombre d'occurrences critiques</div>{% endif %}
    {% if isNeedsUpdate %}<div class="top10-badge" style="background:#ede9fe; color:#5b21b6;">🛠 Sites nécessitant une mise à jour de capacité et/ou de type trans</div>{% endif %}

    <div class="table-wrap">
        <table id="siteTable">
            <thead>
                <tr>
                    <th>Site</th><th>Classification</th><th>Type Trans</th>
                    <th>Max TDD (Mbps)</th><th>Max FDD (Mbps)</th><th>Trafic Max (Mbps)</th>
                    <th>Capacité TDD (Mbps)</th><th>Capacité FDD (Mbps)</th>
                    <th>Taux Util. Global</th><th>Taux Util. TDD</th><th>Taux Util. FDD</th>
                    <th>Occurrences</th><th>Occurrence TDD</th><th>Occurrence FDD</th>
                    <th>Statut (status)</th><th>État (siteStatus)</th>
                    <th>DropCong TDD</th><th>DropCong FDD</th><th>DropCong TF</th>
                    <th>Longitude</th><th>Latitude</th>
                    <th>S1 Fail (s)</th><th>Date coupure S1</th>
                    <th>MAJ Capacité</th><th>Dernière action</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="siteTableBody">
                {% if sites is empty %}
                    <tr><td colspan="26" style="text-align:center; padding:30px; color:#64748b;">Aucun site trouvé. <a href="#" id="importTrigger" style="color:#3b82f6; font-weight:600;">Importer des données</a></td></tr>
                {% else %}
                    {% for site in sites %}
                        {% set needType = not site.typeTrans %}
                        {% set needCapacity = site.capaciteTddMbps is null and site.capaciteFddMbps is null %}
                        {% set etat = site.status is not empty ? (site.status|upper == 'SECURISE' or site.status|upper == 'SECURE' ? 'OK' : (site.status|upper == 'SURVEILLANCE' or site.status|upper == 'WARNING' ? 'SOUS_OBSERVATION' : site.status|upper)) : 'OK' %}
                        {% set st = site.siteStatus is not empty ? (site.siteStatus|upper == 'CONGESTIONNE' ? 'CONGESTION' : site.siteStatus|upper) : 'OK' %}
                        <tr>
                            <td><strong>{{ site.siteName }}</strong></td>
                            <td>{{ site.classification ?: '-' }}</td>
                            <td>
                                {{ site.typeTrans ?: '-' }}
                                {% if needType %}<button class="btn btn-outline btn-sm" data-site="{{ site.siteName }}" data-action="add-type">+ Type</button>{% endif %}
                            </td>
                            <td>{{ site.maxTraficTdd is not null ? site.maxTraficTdd|number_format(2, '.', ' ') : '-' }}</td>
                            <td>{{ site.maxTraficFdd is not null ? site.maxTraficFdd|number_format(2, '.', ' ') : '-' }}</td>
                            <td>{{ site.maxTrafic is not null ? site.maxTrafic|number_format(2, '.', ' ') : '-' }}</td>
                            <td>{{ site.capaciteTddMbps is not null ? site.capaciteTddMbps|number_format(2, '.', ' ') : '-' }}</td>
                            <td>
                                {{ site.capaciteFddMbps is not null ? site.capaciteFddMbps|number_format(2, '.', ' ') : '-' }}
                                {% if needCapacity %}<button class="btn btn-warning-sm btn-sm" data-site="{{ site.siteName }}" data-action="update-capacity">+ Capacité</button>{% endif %}
                            </td>
                            <td>
                                {% set taux = site.tauxUtilisation %}
                                {% if taux is not null %}<span class="badge {% if taux > 90 %}badge-red{% elseif taux > 70 %}badge-yellow{% else %}badge-green{% endif %}">{{ taux|number_format(2, '.', ' ') }}%</span>{% else %}-{% endif %}
                            </td>
                            <td>{{ site.tauxUtilisationTdd is not null ? site.tauxUtilisationTdd|number_format(2, '.', ' ') ~ '%' : '-' }}</td>
                            <td>{{ site.tauxUtilisationFdd is not null ? site.tauxUtilisationFdd|number_format(2, '.', ' ') ~ '%' : '-' }}</td>
                            <td>{{ site.nombreOccurrences ?? '-' }}</td>
                            <td>{{ site.nombreOccurrencesTdd is not null ? site.nombreOccurrencesTdd : '-' }}</td>
                            <td>{{ site.nombreOccurrencesFdd is not null ? site.nombreOccurrencesFdd : '-' }}</td>
                            <td>{{ etat }}</td>
                            <td>
                                <span class="badge {% if etat == 'CRITIQUE' %}badge-red{% elseif etat == 'SOUS_OBSERVATION' %}badge-yellow{% elseif etat == 'OK' %}badge-green{% else %}badge-gray{% endif %}">{{ etat }}</span>
                            </td>
                            <td>{{ site.dropCongTdd is not null ? site.dropCongTdd : '-' }}</td>
                            <td>{{ site.dropCongFdd is not null ? site.dropCongFdd : '-' }}</td>
                            <td>{{ site.dropCongTf is not null ? site.dropCongTf : '-' }}</td>
                            <td>{{ site.longitude is not null ? site.longitude|number_format(6, '.', '') : '-' }}</td>
                            <td>{{ site.latitude is not null ? site.latitude|number_format(6, '.', '') : '-' }}</td>
                            <td>
                                {% if site.s1FailDuration is not null and site.s1FailDuration > 0 %}<span class="badge badge-s1">{{ site.s1FailDuration|number_format(0, '.', ' ') }}s</span>{% else %}-{% endif %}
                            </td>
                            <td>{{ site.s1FailDate ? site.s1FailDate|date('d/m/Y H:i') : '-' }}</td>
                            <td>{{ site.capaciteUpdatedAt ? site.capaciteUpdatedAt|date('d/m/Y H:i') : '-' }}</td>
                            <td>
                                {% if site.lastActionPerformed %}<span title="{{ site.lastActionPerformed }}">{{ site.lastActionPerformed|length > 24 ? (site.lastActionPerformed|slice(0, 24) ~ '…') : site.lastActionPerformed }}</span>{% else %}-{% endif %}
                            </td>
                            <td>
                                <button class="btn btn-outline btn-sm view-kpi" data-site="{{ site.siteName }}">📈 KPI</button>
                                {% if needType or needCapacity %}<span class="badge" style="background:#ede9fe; color:#6d28d9;" title="Nécessite une mise à jour">⚠️</span>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>

    {% if not isTop10 and not isNeedsUpdate and pagination.totalPages > 1 %}
        <div class="pagination">
            {% for p in 1..pagination.totalPages %}
                <a href="?page={{ p }}&search={{ currentSearch }}&service={{ currentService }}&classification={{ currentClassification }}" class="{% if p == pagination.page %}active{% endif %}">{{ p }}</a>
            {% endfor %}
        </div>
    {% endif %}

    <div class="action-buttons">
        <button class="btn btn-success" id="generatePlan">📋 Générer plan d'action</button>
        <button class="btn btn-purple" id="viewAllKpis">📊 Voir Courbe KPIs</button>
    </div>
</div>

<div class="modal-overlay" id="importModal">
    <div class="modal-box">
        <h3>📂 Import requis</h3>
        <p>Vous devez importer des données pour générer le plan data.</p>
        <div class="modal-buttons">
            <button class="btn btn-outline" id="modalCancel">Annuler</button>
            <a href="{{ path('superuser_dashboard_import') }}" class="btn btn-primary-sm" style="padding:10px 24px;">Aller à l'import</a>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('importModal');
    const importTrigger = document.getElementById('importTrigger');
    const modalCancel = document.getElementById('modalCancel');
    function showModal() { modal.classList.add('active'); }
    function hideModal() { modal.classList.remove('active'); }
    if (importTrigger) importTrigger.addEventListener('click', showModal);
    if (modalCancel) modalCancel.addEventListener('click', hideModal);
    {% if importNeeded %}showModal();{% endif %}

    const searchInput = document.getElementById('search');
    const serviceSelect = document.getElementById('service');
    const classSelect = document.getElementById('classification');
    const worstFilter = document.getElementById('worstFilter');
    const applyBtn = document.getElementById('applyFilters');
    const resetBtn = document.getElementById('resetFilters');

    function buildUrl(base, params) { const qs = new URLSearchParams(params).toString(); return qs ? base + '?' + qs : base; }

    applyBtn.addEventListener('click', function() {
        const params = { search: searchInput.value, service: serviceSelect.value, classification: classSelect.value };
        if (worstFilter.value === 'top10') { params.top10 = '1'; } else if (worstFilter.value === 'needsUpdate') { params.needsUpdate = '1'; }
        window.location.href = buildUrl('{{ path('superuser_plan_data') }}', params);
    });
    resetBtn.addEventListener('click', function() { window.location.href = '{{ path('superuser_plan_data') }}'; });

    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('view-kpi')) {
            const site = e.target.dataset.site;
            if (site) { localStorage.setItem('kpis_selected_site', site); window.location.href = '{{ path('superuser_dashboard_kpis') }}'; }
        }
    });
    document.getElementById('viewAllKpis').addEventListener('click', function() { window.location.href = '{{ path('superuser_dashboard_kpis') }}'; });

    document.querySelectorAll('[data-action="add-type"]').forEach(btn => {
        btn.addEventListener('click', function(e) { e.stopPropagation(); alert('Fonction à définir : Ajouter un type trans pour ' + this.dataset.site); });
    });
    document.querySelectorAll('[data-action="update-capacity"]').forEach(btn => {
        btn.addEventListener('click', function(e) { e.stopPropagation(); alert('Fonction à définir : Mettre à jour la capacité pour ' + this.dataset.site); });
    });

    document.getElementById('generatePlan').addEventListener('click', function() {
        const params = { search: searchInput.value, service: serviceSelect.value, classification: classSelect.value };
        if (worstFilter.value === 'top10') { params.filter = 'top10'; }
        window.location.href = buildUrl('{{ path('superuser_ia_recommendations') }}', params);
    });
});
</script>
{% endblock %}