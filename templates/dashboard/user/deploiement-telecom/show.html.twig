{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
    .deploiement-container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
    .card { background:#fff; border-radius:.75rem; border:1px solid #e9edf4; padding:1.25rem; margin-bottom:1.25rem; }
    .section-title { font-size:.95rem; font-weight:600; color:#1e293b; margin-bottom:.8rem; }
    .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
    @media (max-width:640px) { .grid-2 { grid-template-columns:1fr; } }
    .form-group { margin-bottom:.9rem; }
    .form-label { display:block; font-size:.78rem; font-weight:500; color:#334155; margin-bottom:.2rem; }
    .form-control { width:100%; border:1px solid #d1d5db; border-radius:.4rem; padding:.4rem .6rem; font-size:.85rem; background:#fff; }
    .form-control:focus { outline:none; border-color:#2e75b6; }
    .btn-success { padding:.5rem 1.2rem; border-radius:.4rem; border:none; font-weight:600; cursor:pointer; background:#16a34a; color:#fff; }
    .btn-success:hover { background:#15803d; }
    .btn-success:disabled { background:#9ca3af; cursor:not-allowed; }
    .site-btn { padding:.4rem .8rem; border-radius:.4rem; border:1px solid #d1d5db; background:#fff; cursor:pointer; font-size:.85rem; display:inline-flex; align-items:center; gap:.4rem; text-decoration:none; color:#1e293b; }
    .site-btn:hover { background:#f1f5f9; }
    .site-btn.active { border-color:#2e75b6; background:#eff6ff; }
    .site-btn.completed { background:#d1fae5; border-color:#10b981; color:#065f46; cursor:default; opacity:.75; pointer-events:none; }
    .progress-bar { width:100%; height:.5rem; background:#e2e8f0; border-radius:9999px; overflow:hidden; margin:.5rem 0; }
    .progress-bar .fill { height:100%; background:#2e75b6; }
    .badge-status { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 9999px; font-size: 0.65rem; font-weight: 600; text-transform: capitalize; }
    .badge-open { background: #dbeafe; color: #1e40af; }
    .badge-in_progress { background: #fef3c7; color: #92400e; }
    .badge-completed { background: #d1fae5; color: #065f46; }
    .badge-closed { background: #e5e7eb; color: #374151; }
    .badge-blocked { background: #fee2e2; color: #991b1b; }
    .badge-waiting_superuser { background: #f3e8ff; color: #6b21a5; }
    .checkbox-group { display: flex; gap: 1rem; flex-wrap: wrap; }
    .checkbox-group label { display: flex; align-items: center; gap: 0.3rem; font-size: 0.85rem; }
    .info-box { background: #f0f4ff; border-left: 4px solid #2e75b6; padding: 0.8rem 1rem; border-radius: 0.4rem; margin-bottom: 1rem; color: #1e293b; }
    .info-box strong { color: #2e75b6; }
    .warning-box { background: #fff3cd; border-left: 4px solid #ffc107; padding: 0.8rem 1rem; border-radius: 0.4rem; margin-bottom: 1rem; }

    .btn-back-rose {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #ec4899;
        color: #fff;
        padding: 0.5rem 1.2rem;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        border: none;
        text-decoration: none;
        transition: background 0.2s, transform 0.1s;
        box-shadow: 0 4px 10px rgba(236, 72, 153, 0.25);
        margin-bottom: 1rem;
    }
    .btn-back-rose:hover {
        background: #db2777;
        color: #fff;
        text-decoration: none;
        transform: translateY(-1px);
    }
</style>

<div class="deploiement-container">
    <a href="{{ path('user_deploiement_index') }}" class="btn-back-rose">← Retour à mes tâches</a>

    <h1 class="text-xl font-bold">{{ task.title }}</h1>
    <p class="text-sm text-gray-500 mb-4">Ticket · {{ ticket.title }} — Étape : {{ task.stepCode|replace({'_': ' '})|capitalize }}</p>

    <div class="card">
        <div class="grid-2">
            <div><span class="text-sm text-gray-500">Statut :</span> <span class="badge-status badge-{{ task.status|replace({'_': ''})|lower }}">{{ task.status|replace({'_': ' '})|capitalize }}</span></div>
            <div><span class="text-sm text-gray-500">Progression ticket :</span> {{ ticket.progress }}%</div>
        </div>
        <div class="progress-bar"><div class="fill" style="width: {{ ticket.progress }}%;"></div></div>
    </div>

    <div class="card">
        <h2 class="section-title">📋 Sites à traiter ({{ totalSites }})</h2>
        <div class="flex flex-wrap gap-2">
            {% for site in sites %}
                {% set decision = siteDecisions[site.id] ?? null %}
                <a href="{{ decision ? '#' : path('user_deploiement_task_show', {id: task.id, site: site.id}) }}"
                   class="site-btn {% if selectedSite and site.id == selectedSite.id %}active{% endif %} {% if decision %}completed{% endif %}"
                   {% if decision %}onclick="return false;"{% endif %}>
                    {% if decision %}✓{% endif %} {{ site.siteName }}
                </a>
            {% else %}
                <span class="text-gray-400">Aucun site</span>
            {% endfor %}
        </div>
    </div>

    {% set selectedDecision = selectedSite ? siteDecisions[selectedSite.id] ?? null : null %}

    {# ========== CAS: Création WO IP ========== #}
    {% if isCreationWoIp %}
        <div class="card">
            <div class="warning-box">
                <strong>⚠️ Attention :</strong> Cette tâche de <strong>Création WO IP</strong> est gérée par le département <strong>Ingénierie IP</strong>.
                Vous ne pouvez pas effectuer d'action sur cette étape.
            </div>
            <a href="{{ path('user_deploiement_index') }}" class="btn btn-secondary">Retour à mes tâches</a>
        </div>

    {# ========== CAS: Décision MLO initiale (upgrade hard FH) ========== #}
    {% elseif isFhMlo and task.status not in ['done', 'completed'] %}
        <div class="card">
            <h2 class="section-title">⚙️ Décision MLO {% if selectedSite %}pour <strong>{{ selectedSite.siteName }}</strong>{% endif %}</h2>
            <div class="info-box">
                <strong>📋 Upgrade hard FH : valider le MLO.</strong> Selon la décision, le site sera transmis
                à Ingénierie Capillaire (OK) ou à Ingénierie IP pour le LLD port routeur (NOK).
            </div>
            <form method="post" action="{{ path('user_deploiement_mlo_decision', {id: task.id}) }}">
                <div class="form-group">
                    <label class="form-label">Décision MLO</label>
                    <select name="mlo_decision" class="form-control" required>
                        <option value="OK">✅ OK — MLO réalisé avec succès</option>
                        <option value="NOK">❌ NOK — Problème MLO</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Commentaire</label>
                    <textarea name="comment" rows="3" class="form-control"></textarea>
                </div>
                <button type="submit" class="btn-success">✅ Valider la décision MLO</button>
            </form>
        </div>

    {# ========== CAS: Validation MLO finale (après retour du LLD Ingénierie IP) ========== #}
    {% elseif isFhMloValidation and task.status not in ['done', 'completed'] %}
        <div class="card">
            <h2 class="section-title">⚙️ Validation MLO finale {% if selectedSite %}pour <strong>{{ selectedSite.siteName }}</strong>{% endif %}</h2>
            <div class="info-box">
                <strong>📋 Le LLD port routeur a été traité par Ingénierie IP.</strong> Validez le MLO pour clore le site
                (il passera ensuite en attente de validation superuser).
            </div>
            <form method="post" action="{{ path('user_deploiement_mlo_validation', {id: task.id}) }}">
                <div class="form-group">
                    <label class="form-label">Commentaire</label>
                    <textarea name="comment" rows="3" class="form-control"></textarea>
                </div>
                <button type="submit" class="btn-success">✅ Valider le MLO</button>
            </form>
        </div>

    {# ========== CAS: Planification standard ========== #}
    {% elseif isPlanification and selectedSite and not selectedDecision and task.status not in ['done', 'completed'] %}
        <div class="card">
            <h2 class="section-title">⚙️ Planification pour <strong>{{ selectedSite.siteName }}</strong></h2>
            <div class="info-box">
                <strong>📋 Planifier l'intervention et coordonner avec les supports.</strong>
            </div>
            <form method="post" action="{{ path('user_deploiement_site_decision', {id: task.id, siteId: selectedSite.id}) }}">
                <div class="form-group">
                    <label class="form-label">Date de planification</label>
                    <input type="date" name="planification" class="form-control" required>
                </div>
                {% if isFoPlanning %}
                    <div class="info-box">
                        <strong>📡 Supports Radio et Backhaul</strong> seront automatiquement notifiés après l’enregistrement de la planification FO.
                    </div>
                {% else %}
                    <div class="form-group">
                        <label class="form-label">Coordination avec les supports</label>
                        <div class="checkbox-group">
                            <label><input type="checkbox" name="radio_ok" value="1"> Support Radio</label>
                            <label><input type="checkbox" name="backhaul_ok" value="1"> Support Backhaul</label>
                        </div>
                        <p class="text-xs text-gray-500">Cochez les supports concernés, puis validez pour leur transmettre la demande.</p>
                    </div>
                {% endif %}
                <div class="form-group">
                    <label class="form-label">Commentaire</label>
                    <textarea name="comment" rows="3" class="form-control"></textarea>
                </div>
                <button type="submit" class="btn-success">✅ {{ isFoPlanning ? 'Planifier et notifier les supports' : 'Envoyer aux supports' }}</button>
            </form>
        </div>

    {# ========== CAS: Exécution ========== #}
    {% elseif isExecution and selectedSite and not selectedDecision and task.status not in ['done', 'completed'] %}
        <div class="card">
            <h2 class="section-title">⚙️ Validation de l'exécution pour <strong>{{ selectedSite.siteName }}</strong></h2>
            <div class="info-box">
                <strong>✅ Les supports ont validé. Confirmez l'action sur le terrain.</strong>
            </div>
            <form method="post" action="{{ path('user_deploiement_site_decision', {id: task.id, siteId: selectedSite.id}) }}">
                <div class="form-group">
                    <label class="form-label">Décision</label>
                    <select name="decision" class="form-control">
                        <option value="OK">✅ OK — Action réalisée avec succès</option>
                        <option value="NOK">❌ NOK — Problème rencontré</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Commentaire</label>
                    <textarea name="comment" rows="3" class="form-control"></textarea>
                </div>
                <button type="submit" class="btn-success">✅ Valider l'exécution</button>
            </form>
        </div>

    {# ========== CAS: Swap routeur ========== #}
    {% elseif isSwap and selectedSite and not selectedDecision and task.status not in ['done', 'completed'] %}
        <div class="card">
            <h2 class="section-title">⚙️ Swap routeur pour <strong>{{ selectedSite.siteName }}</strong></h2>
            <div class="info-box">
                <strong>🔄 Confirmez que le swap routeur a été effectué.</strong>
            </div>
            <form method="post" action="{{ path('dashboard_fo_complete_swap', {id: task.id}) }}">
                <div class="form-group">
                    <label class="form-label">Swap effectué</label>
                    <div class="checkbox-group">
                        <label><input type="checkbox" name="decision" value="OK"> ✅ Swap done</label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Commentaire</label>
                    <textarea name="comment" rows="3" class="form-control"></textarea>
                </div>
                <button type="submit" class="btn-success">✅ Valider le swap</button>
            </form>
        </div>

    {# ========== CAS: Raccordement 2ème paire ========== #}
    {% elseif isRaccordement and selectedSite and not selectedDecision and task.status not in ['done', 'completed'] %}
        <div class="card">
            <h2 class="section-title">⚙️ Raccordement 2ème paire pour <strong>{{ selectedSite.siteName }}</strong></h2>
            <div class="info-box">
                <strong>📋 Raccordement FO demandé par Ingénierie Capillaire.</strong>
            </div>
            <form method="post" action="{{ path('user_deploiement_site_decision', {id: task.id, siteId: selectedSite.id}) }}">
                <div class="form-group">
                    <label class="form-label">Date de planification</label>
                    <input type="date" name="planification" class="form-control" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Raccordement FO</label>
                    <select name="raccordement_ok" class="form-control">
                        <option value="OK">✅ OK — Raccordement réussi</option>
                        <option value="NOK">❌ NOK — Échec</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Commentaire</label>
                    <textarea name="comment" rows="3" class="form-control"></textarea>
                </div>
                <button type="submit" class="btn-success">✅ Valider le raccordement</button>
            </form>
        </div>

    {# ========== Site déjà traité ========== #}
    {% elseif selectedSite and selectedDecision %}
        <div class="card">
            <div class="bg-green-50 border border-green-200 rounded-lg p-4 text-green-700 text-center">
                ✅ Site déjà traité
                {% set comment = selectedDecision.execution_comment ?? selectedDecision.comment ?? null %}
                {% if comment %}<br><span class="text-sm">Commentaire : {{ comment }}</span>{% endif %}
            </div>
        </div>

    {# ========== Tâche déjà terminée ========== #}
    {% elseif task.status == 'done' or task.status == 'completed' %}
        <div class="card">
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-blue-700 text-center">✅ Cette tâche est déjà terminée.</div>
        </div>

    {# ========== Aucune action ========== #}
    {% else %}
        <div class="card">
            <div class="info-box"><p>Aucune action spécifique pour cette étape.</p></div>
        </div>
    {% endif %}

    {# Historique #}
    <div class="card">
        <h2 class="section-title">📜 Historique</h2>
        {% for entry in ticket.history %}
            <div class="mb-2">
                <span class="text-xs text-gray-400">{{ entry.createdAt ? entry.createdAt|date('d/m/Y H:i') : '-' }}</span>
                <strong>{{ entry.action|replace({'_': ' '})|capitalize }}</strong>
                <span class="text-sm text-gray-600">{{ entry.details }}</span>
            </div>
        {% else %}
            <p class="text-gray-400">Aucun historique.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}