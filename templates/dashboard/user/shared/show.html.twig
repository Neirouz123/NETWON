{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
    .shared-container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
    .card { background:#fff; border-radius:.75rem; border:1px solid #e9edf4; padding:1.25rem; margin-bottom:1.25rem; }
    .section-title { font-size:.95rem; font-weight:600; color:#1e293b; margin-bottom:.8rem; }
    .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
    @media (max-width:640px) { .grid-2 { grid-template-columns:1fr; } }
    .form-group { margin-bottom:.9rem; }
    .form-label { display:block; font-size:.78rem; font-weight:500; color:#334155; margin-bottom:.2rem; }
    .form-control { width:100%; border:1px solid #d1d5db; border-radius:.4rem; padding:.4rem .6rem; font-size:.85rem; background:#fff; }
    .form-control:focus { outline:none; border-color:#8b5cf6; box-shadow:0 0 0 3px rgba(139,92,246,.1); }
    .btn-success { padding:.5rem 1.2rem; border-radius:.4rem; border:none; font-weight:600; cursor:pointer; background:#16a34a; color:#fff; }
    .btn-success:hover { background:#15803d; }
    .btn-success:disabled { background:#9ca3af; cursor:not-allowed; }
    .btn-secondary { padding:.5rem 1.2rem; border-radius:.4rem; border:none; font-weight:600; cursor:pointer; background:#6b7280; color:#fff; }
    .btn-secondary:hover { background:#4b5563; }
    .site-badge { display:inline-block; padding:.2rem .7rem; border-radius:999px; font-size:.75rem; font-weight:600; background:#f3f4f6; color:#1f2937; margin:2px; }
    .site-badge.fh { background:#fef3c7; color:#92400e; }
    .site-badge.fo { background:#dbeafe; color:#1e40af; }
    .progress-bar { width:100%; height:.5rem; background:#e2e8f0; border-radius:9999px; overflow:hidden; margin:.5rem 0; }
    .progress-bar .fill { height:100%; background:#8b5cf6; }
    .badge-status { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 9999px; font-size: 0.65rem; font-weight: 600; text-transform: capitalize; }
    .badge-open { background: #dbeafe; color: #1e40af; }
    .badge-in_progress { background: #fef3c7; color: #92400e; }
    .badge-completed { background: #d1fae5; color: #065f46; }
    .badge-closed { background: #e5e7eb; color: #374151; }
    .badge-blocked { background: #fee2e2; color: #991b1b; }
    .badge-waiting_superuser { background: #f3e8ff; color: #6b21a5; }
    .info-box { background: #f5f0ff; border-left: 4px solid #8b5cf6; padding: 0.8rem 1rem; border-radius: 0.4rem; margin-bottom: 1rem; color: #1e293b; }
    .info-box strong { color: #8b5cf6; }
    .btn-back-rose {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #ec4899;
        color: #fff;
        padding: 0.5rem 1.2rem;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        border: none;
        text-decoration: none;
        transition: background 0.2s, transform 0.1s;
        box-shadow: 0 4px 10px rgba(236, 72, 153, 0.25);
        margin-bottom: 1rem;
    }
    .btn-back-rose:hover { background: #db2777; color: #fff; text-decoration: none; transform: translateY(-1px); }
</style>

<div class="shared-container">
    <a href="{{ path('user_shared_tasks') }}" class="btn-back-rose">← Retour à mes tâches</a>

    <h1 class="text-xl font-bold">{{ task.title }}</h1>
    <p class="text-sm text-gray-500 mb-4">Ticket · {{ ticket.title }} — Étape : {{ task.stepCode|replace({'_': ' '})|capitalize }}</p>

    <div class="card">
        <div class="grid-2">
            <div><span class="text-sm text-gray-500">Statut :</span> <span class="badge-status badge-{{ task.status|replace({'_': ''})|lower }}">{{ task.status|replace({'_': ' '})|capitalize }}</span></div>
            <div><span class="text-sm text-gray-500">Progression ticket :</span> {{ ticket.progress }}%</div>
        </div>
        <div class="progress-bar"><div class="fill" style="width: {{ ticket.progress }}%;"></div></div>
    </div>

    <div class="card">
        <h2 class="section-title">📋 Sites concernés par cette tâche</h2>
        <div class="flex flex-wrap gap-2">
            {% for site in sites %}
                <span class="site-badge {% if site.typeTrans|upper == 'FH' %}fh{% elseif site.typeTrans|upper == 'FO' %}fo{% endif %}">
                    {{ site.siteName }}
                    {% if site.typeTrans %}({{ site.typeTrans }}){% endif %}
                </span>
            {% else %}
                <span class="text-gray-400">Aucun site associé</span>
            {% endfor %}
        </div>
    </div>

    {# Formulaire de complétion – visible si la tâche est en attente ou en cours #}
    {% if task.status != 'done' and task.status != 'completed' %}
        <div class="card">
            <h2 class="section-title">⚙️ Compléter la tâche</h2>
            <div class="info-box">
                <strong>📋 Renseignez les informations ci-dessous pour finaliser l'intervention.</strong>
                <br>Un email sera envoyé à l'adresse saisie.
            </div>
            <form method="post" action="{{ path('user_shared_task_complete', {id: task.id}) }}">
                <div class="form-group">
                    <label class="form-label">Email de l'intervenant concerné *</label>
                    <input type="email" name="intervenant_email" class="form-control" required placeholder="ex: intervenant@domaine.com">
                </div>
                <div class="form-group">
                    <label class="form-label">Description de l'état du site *</label>
                    <textarea name="site_etat" rows="3" class="form-control" required placeholder="Décrivez l'état actuel du site (ex: trafic, incidents, etc.)"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Action proposée *</label>
                    <textarea name="action_proposee" rows="3" class="form-control" required placeholder="Quelle action recommandez-vous ?"></textarea>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn-success">✅ Terminer et notifier</button>
                    <a href="{{ path('user_shared_tasks') }}" class="btn-secondary" style="margin-left:0.5rem;">Annuler</a>
                </div>
            </form>
        </div>
    {% else %}
        <div class="card">
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-blue-700 text-center">
                ✅ Cette tâche est déjà terminée.
            </div>
        </div>
    {% endif %}

    {# Historique #}
    <div class="card">
        <h2 class="section-title">📜 Historique</h2>
        {% for entry in history %}
            <div class="mb-2">
                <span class="text-xs text-gray-400">{{ entry.createdAt ? entry.createdAt|date('d/m/Y H:i') : '-' }}</span>
                <strong>{{ entry.action|replace({'_': ' '})|capitalize }}</strong>
                <span class="text-sm text-gray-600">{{ entry.details }}</span>
                {% if entry.site %}
                    <span class="text-xs text-gray-400">(Site: {{ entry.site }})</span>
                {% endif %}
            </div>
        {% else %}
            <p class="text-gray-400">Aucun historique.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}